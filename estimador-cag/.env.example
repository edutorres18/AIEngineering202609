# Copia este archivo a .env y completa tus valores. .env NUNCA se sube al repo.
# Las variables vacías toman el valor por defecto indicado.

# API key de OpenAI (requerida si LLM_PROVIDER=openai)
OPENAI_API_KEY=
# API key de Anthropic (requerida si LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Proveedor: openai | anthropic (por defecto: openai)
LLM_PROVIDER=
# Modelo (por defecto: gpt-4o-mini con openai, claude-haiku-4-5 con anthropic)
LLM_MODEL=
# Límite de tokens de salida (por defecto: 3000)
LLM_MAX_OUTPUT_TOKENS=
# Temperatura, solo OpenAI (por defecto: 0.2)
LLM_TEMPERATURE=
# Timeout de la llamada al LLM en segundos (por defecto: 60)
LLM_TIMEOUT_SECONDS=

# Entorno: development | test | staging | production (por defecto: development)
APP_ENV=
# Nivel de logging: DEBUG | INFO | WARNING | ERROR | CRITICAL (por defecto: DEBUG)
LOG_LEVEL=
